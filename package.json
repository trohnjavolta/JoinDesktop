{
  "name": "com.joaomgcd.join",
  "productName": "Join Desktop",
  "homepage": "https://joaoapps.com/join/desktop",
  "version": "1.2.0",
  "author": {
    "name": "trohnjavolta",
    "email": "fabianrumer90@gmail.com"
  },
  "description": "A companion app for the Join website",
  "main": "main_esm.js",
  "scripts": {
    "build:push": "node scripts/build-push-receiver.js",
    "postinstall": "install-app-deps",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "makemac": "electron-installer-dmg",
    "pack": "electron-builder build --dir",
    "dist": "electron-builder build"
  },
  "keywords": [
    "Join",
    "Android"
  ],
  "author": {
    "name": "joaomgcd",
    "email": "support@joaoapps.com"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0-beta.52",
    "@electron-forge/maker-deb": "^6.0.0-beta.52",
    "@electron-forge/maker-dmg": "^6.0.0-beta.52",
    "@electron-forge/maker-rpm": "^6.0.0-beta.52",
    "@electron-forge/maker-squirrel": "^6.0.0-beta.52",
    "@electron-forge/maker-zip": "^6.0.0-beta.52",
    "electron": "30.5.1",
    "electron-builder": "24.9.1",
    "electron-installer-dmg": "^3.0.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@eneris/push-receiver": "^4.4.0",
    "auto-launch": "^5.0.5",
    "electron-fetch": "^1.7.3",
    "esm": "^3.2.25",
    "http-terminator": "2.0.3",
    "network": "^0.5.0",
    "node-fetch": "^2.6.0",
    "node-notifier": "^7.0.1",
    "url-exist": "^2.0.2"
  },
  "build": {
    "files": [
      "**/*",
      "!dist/**",
      "!dist-test/**",
      "!.abacusai/**"
    ],
    "asarUnpack": [
      "./node_modules/node-notifier/**"
    ],
    "appId": "com.joaomgcd.join",
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "join-desktop",
      "maintainer": "trohnjavolta <fabianrumer90@gmail.com>",
      "target": [
        "deb"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "join_portable.exe"
    },
    "nsis": {
      "artifactName": "Join.Desktop.Setup.${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "out": "dist"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "com.joaomgcd.join",
            "iconUrl": "https://raw.githubusercontent.com/markwal/GpxUi/master/gpx.ico",
            "loadingGif": "joinloading.png",
            "setupIcon": "join.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ],
          "icon": "./join.png"
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "background": "./images/account_background.png",
            "icon": "./join.icns",
            "format": "ULFO"
          }
        }
      ]
    }
  }
}
